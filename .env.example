# Spotter AI — Environment Configuration

# Backend Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Routing Provider API Keys
# Optional: OpenRouteService API key for live alternative truck routes
# Obtain a free key from: https://openrouteservice.org/dev/#/signup
# If not provided, Spotter AI gracefully falls back to OSRM / robust multi-route routing.
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Open-Meteo Weather API
# Open-Meteo is free and does not require an API key for non-commercial and standard tier use.
# Optional customer tier API key if applicable:
OPENMETEO_API_KEY=

# Frontend Port Configuration
VITE_API_BASE_URL=http://localhost:8000
